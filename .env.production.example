# ==============================================================================
# AURION EYE — Variáveis de Ambiente para Coolify / Produção
# Cole este bloco em "Environment Variables > Developer View" no Coolify
# ==============================================================================

# Segurança & Banco de Dados
AURION_TOKEN=aurion-dev-secret-token-2026
# Para PostgreSQL no Coolify, descomente e troque pela sua URL interna:
# DATABASE_URL=postgresql+asyncpg://postgres:SUA_SENHA@aurion-postgres:5432/postgres
CLAUDE_DAILY_CAP=15

# ==============================================================================
# POOL DE IAs GRATUITAS (O Adaptive Router alterna automaticamente entre elas)
# Basta preencher quantas quiser — as vazias são ignoradas automaticamente
# ==============================================================================

# 1. Groq (Llama 3.3 70B — ultra-rápido para voz) -> https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google AI Studio (Gemini Flash Latest — visão & 1M contexto) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2b. Cloudflare Workers AI (Qwen 3.8 27B — 10k Neurons/dia grátis) -> https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 3. OpenRouter (Inclui Nous Hermes 3 405B Free + pool :free) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. SambaNova Cloud (Llama 3.3 70B em LPU gratuita) -> https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# 5. Cerebras (Inferência ultrarrápida gratuita) -> https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# 6. Mistral Studio (Codestral gratuito para código) -> https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# 7. NVIDIA NIM (Créditos gratuitos Llama 3.3 / DeepSeek) -> https://build.nvidia.com/
NVIDIA_API_KEY=

# 8. GitHub Models (GPT-4o-mini gratuito com sua conta GitHub) -> https://github.com/settings/tokens
GITHUB_MODELS_PAT=

# 9. Hugging Face Inference (Qwen 2.5 72B) -> https://huggingface.co/settings/tokens
HF_TOKEN=

# 10. Cohere (Command R+ Trial gratuito) -> https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# 11. RunCrate AI Gateway
RUNCRATE_API_KEY=

# 12. Voz Neural Natural (ElevenLabs -> fallback automático Edge TTS)
ELEVENLABS_API_KEY=

# 13. Runway (Vídeo/Mídia)
RUNWAY_API_KEY=

# 14. Evolution API (WhatsApp) & Cloudflare R2
EVOLUTION_API_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Último recurso opcional (só aciona após 2 falhas consecutivas dos modelos free)
ANTHROPIC_API_KEY=
